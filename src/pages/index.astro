---
import Terminal from '../layouts/Terminal.astro';
import { tabs } from '../nav';

const dirs = tabs.filter((tab) => tab.href !== '/');
---

<Terminal>
	<p class="cmd">cat /etc/motd</p>
	<div class="out motd">
		<p>We build trusted, reproducible foundations for platform teams:</p>
		<p><span class="bullet">›</span> software supply chain security: signed, attested, verifiable</p>
		<p><span class="bullet">›</span> security controls humans always needed, and AI agents absolutely require</p>
		<p><span class="bullet">›</span> hardened containers and dev environments</p>
		<p><span class="bullet">›</span> policy as code, infrastructure as code, and configuration as code</p>
		<p><span class="bullet">›</span> fast CLIs and TUIs over slow web UIs: stay in the terminal</p>
	</div>

	<p class="cmd">ls ~</p>
	<ul class="out ls">
		{
			dirs.map((dir) => (
				<li>
					<a href={dir.href}>{dir.label}/</a>
				</li>
			))
		}
	</ul>
</Terminal>

<style>
	.motd p {
		margin: 0;
	}

	.motd p:first-child {
		margin-bottom: 0.5rem;
	}

	/* hanging indent so wrapped lines align past the bullet */
	.motd p:not(:first-child) {
		padding-left: 2ch;
		text-indent: -2ch;
	}

	.bullet {
		color: var(--blue);
	}

	.ls {
		padding: 0;
		list-style: none;
	}
</style>

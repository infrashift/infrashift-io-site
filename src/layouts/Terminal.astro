---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Prompt from '../components/Prompt.astro';
import StatusBar from '../components/StatusBar.astro';

interface Props {
	title?: string;
	description?: string;
	cwd?: string;
}

const {
	title,
	description = 'infrashift builds software supply chain security tooling and fast, keyboard-driven TUIs.',
	cwd = '~' + Astro.url.pathname.replace(/\/+$/, ''),
} = Astro.props;

const pageTitle = title ? `${title} · infrashift` : 'infrashift';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#e0af68" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="window">
			<header class="titlebar">
				<span class="title">tmux a -t infrashift</span>
				<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
			</header>
			<div class="tmux">
				<div class="pane pane-prompt">
					<Prompt href="/" />
				</div>
				<aside class="pane pane-info" aria-label="Summary">
					<p class="whoami">
						<span class="user">dev</span><span class="dim">@</span><span class="host"
							>infrashift.io</span
						>
					</p>
					<p class="rule dim" aria-hidden="true">─────────────────</p>
					<dl>
						<div><dt>focus</dt><dd>software supply chain security</dd></div>
						<div><dt>builds</dt><dd>signed · attested · reproducible</dd></div>
						<div><dt>ui</dt><dd>cli + tui &gt; slow web ui</dd></div>
					</dl>
				</aside>
				<main class="pane pane-main">
					<div class="content">
						<slot />
					</div>
				</main>
			</div>
			<StatusBar cwd={cwd} />
		</div>
	</body>
</html>

<style>
	body {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem;
	}

	.window {
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 1040px;
		height: min(calc(100dvh - 4rem), 860px);
		background: var(--bg-alpha);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		border: 1px solid var(--border);
		border-radius: 10px;
		box-shadow:
			0 30px 70px rgba(26, 27, 38, 0.45),
			0 8px 20px rgba(26, 27, 38, 0.25),
			inset 0 1px 0 rgba(192, 202, 245, 0.06);
		overflow: hidden;
	}

	.titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.35rem 0.9rem;
		border-bottom: 1px solid var(--border);
		font-size: 0.8rem;
		color: var(--comment);
	}

	.dots {
		display: flex;
		gap: 6px;
	}

	.dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--highlight);
		border: 1px solid var(--border);
	}

	/* tmux layout: two panes on top, the active main pane below */
	.tmux {
		flex: 1;
		min-height: 0;
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		grid-template-rows: auto minmax(0, 1fr);
	}

	.pane {
		min-width: 0;
		padding: 0.75rem 1.25rem;
	}

	/* tmux highlights the border shared with the active pane */
	.pane-prompt {
		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--blue);
		font-size: 1.35rem;
	}

	.pane-info {
		border-bottom: 1px solid var(--blue);
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.pane-info p {
		margin: 0;
	}

	.user {
		color: var(--blue);
		font-weight: 700;
	}

	.host {
		color: var(--magenta);
		font-weight: 700;
	}

	.pane-info dl {
		margin: 0;
	}

	.pane-info dl div {
		display: flex;
		gap: 1ch;
	}

	.pane-info dt {
		min-width: 7ch;
		color: var(--yellow);
	}

	.pane-info dd {
		margin: 0;
		color: var(--fg-dim);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.pane-main {
		grid-column: 1 / -1;
		overflow-y: auto;
		padding: 1.5rem 1.5rem 2rem;
		scrollbar-width: thin;
		scrollbar-color: var(--border) transparent;
	}

	.content {
		max-width: 82ch;
	}

	@media (max-width: 640px) {
		body {
			padding: 16px;
			align-items: stretch;
		}

		.window {
			height: calc(100dvh - 32px);
		}

		.tmux {
			grid-template-columns: minmax(0, 1fr);
		}

		.pane-prompt {
			border-right: none;
			font-size: 1.2rem;
		}

		.pane-info {
			display: none;
		}

		.pane-main {
			padding: 1.25rem 1rem 1.5rem;
		}
	}
</style>

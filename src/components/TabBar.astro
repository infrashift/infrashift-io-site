---
import { tabs, isActive } from '../nav';

const { pathname } = Astro.url;
---

<nav class="tabs" aria-label="Main">
	<ul>
		{
			tabs.map((tab) => {
				const active = isActive(tab, pathname);
				return (
					<li>
						<a
							href={tab.href}
							class:list={['tab', { active }]}
							aria-current={active ? 'page' : undefined}
							aria-keyshortcuts={tab.key}
							data-key={tab.key}
						>
							{active ? (
								<span class="key">[{tab.key}]</span>
							) : (
								<span class="key">{tab.key}:</span>
							)}
							<span class="label">{tab.label}</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>

<script>
	// number keys switch tabs, like lazygit/k9s
	document.addEventListener('keydown', (event) => {
		if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
		const target = event.target as HTMLElement | null;
		if (target?.closest('input, textarea, select, [contenteditable]')) return;

		const tab = document.querySelector<HTMLAnchorElement>(`.tabs a[data-key="${event.key}"]`);
		if (tab && !tab.classList.contains('active')) {
			event.preventDefault();
			window.location.href = tab.href;
		}
	});
</script>

<style>
	.tabs {
		border-bottom: 1px solid var(--border);
		overflow-x: auto;
		scrollbar-width: none;
	}

	ul {
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0.4rem 0.75rem;
		list-style: none;
		white-space: nowrap;
	}

	.tab {
		display: inline-block;
		padding: 0.1rem 0.6rem;
		border-radius: 3px;
		color: var(--fg);
	}

	.tab:hover {
		text-decoration: none;
		background: rgba(41, 46, 66, 0.6);
	}

	.tab:hover .label {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.key {
		color: var(--comment);
	}

	.tab.active {
		background: var(--highlight);
		color: var(--blue);
		font-weight: 700;
	}

	.tab.active .key {
		color: var(--blue);
	}

	.tab.active:hover .label {
		text-decoration: none;
	}

	@media (max-width: 640px) {
		ul {
			gap: 0;
			padding: 0.4rem 0.5rem;
			font-size: 0.9rem;
		}

		.tab {
			padding: 0.1rem 0.35rem;
		}
	}
</style>
